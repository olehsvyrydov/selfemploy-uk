<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="uk.selfemploy.ui.controller.BackupPassphraseController"
           styleClass="onboarding-container" prefWidth="560" prefHeight="560">

    <VBox styleClass="onboarding-card" alignment="CENTER" spacing="14" maxWidth="460">
        <StackPane styleClass="onboarding-icon-circle" minWidth="56" minHeight="56"
                   maxWidth="56" maxHeight="56">
            <FontIcon iconLiteral="fas-file-export" iconSize="24" styleClass="onboarding-icon"/>
        </StackPane>
        <Label fx:id="titleLabel" text="%backup.title" styleClass="onboarding-title"/>
        <Label fx:id="subtitleLabel" text="%backup.subtitle" styleClass="onboarding-subtitle" wrapText="true"/>

        <CheckBox fx:id="encryptCheckbox" text="%backup.encrypt" onAction="#handleEncryptToggled"/>

        <VBox fx:id="passphrasePane" styleClass="form-field" spacing="6" maxWidth="380">
            <CheckBox fx:id="useAppPassphraseCheckbox" text="%backup.useAppPassphrase"
                      onAction="#handleUseAppPassphraseToggled" visible="false" managed="false"/>
            <Label fx:id="useAppPassphraseHint" text="%backup.useAppPassphrase.hint"
                   styleClass="field-hint" wrapText="true" visible="false" managed="false"/>
            <PasswordField fx:id="passphraseField" styleClass="form-input"
                           promptText="%backup.passphrase.prompt"/>
            <PasswordField fx:id="confirmField" styleClass="form-input"
                           promptText="%backup.confirm.prompt" onAction="#handleExport"/>
            <Label fx:id="hintLabel" styleClass="field-hint" wrapText="true"/>
            <Label fx:id="errorLabel" styleClass="field-error" wrapText="true"
                   visible="false" managed="false"/>
        </VBox>

        <VBox fx:id="plaintextWarningPane" styleClass="privacy-assurance-box" spacing="6" maxWidth="400"
              visible="false" managed="false">
            <Label text="%backup.plaintext.title" styleClass="field-label"/>
            <Label text="%backup.plaintext.body" styleClass="field-hint" wrapText="true"/>
        </VBox>

        <Button fx:id="exportButton" text="%backup.export" styleClass="button-primary, button-large"
                maxWidth="380" onAction="#handleExport"/>
        <Hyperlink fx:id="cancelLink" text="%backup.cancel" onAction="#handleCancel"/>
    </VBox>
</StackPane>
